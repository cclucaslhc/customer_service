# Separate TLS load balancer in front of the two same-host API edges.
# Replace every placeholder; this does not provide HA for the LB itself.
upstream customer_service_edges {
    server @PRIMARY_EDGE@ max_fails=1 fail_timeout=10s;
    server @BACKUP_EDGE@ backup;
    keepalive 16;
}
server {
    listen @PRIVATE_LISTEN@ ssl;
    server_name @CANONICAL_HOST@;
    ssl_certificate @TLS_CERTIFICATE_PATH@;
    ssl_certificate_key @TLS_PRIVATE_KEY_PATH@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;
    access_log off;
    client_max_body_size @APPROVED_UPLOAD_LIMIT@;
    location / {
        proxy_pass https://customer_service_edges;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate @UPSTREAM_CA_PATH@;
        proxy_ssl_server_name on;
        proxy_ssl_name @CANONICAL_HOST@;
        proxy_set_header Host @CANONICAL_HOST@;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_connect_timeout 2s;
        proxy_read_timeout 900s;
        proxy_send_timeout 60s;
        # Never add non_idempotent: ambiguous POSTs require application-level
        # request-id reconciliation, not transparent proxy replay.
        proxy_next_upstream error timeout invalid_header http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_buffering off;
        proxy_cache off;
        add_header X-Accel-Buffering no always;
    }
}
