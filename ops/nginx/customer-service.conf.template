# Review and replace every @...@ value before installation. This file is an
# operator template, not a deployable production configuration. Install one
# same-host proxy beside each loopback-only API; the VIP/LB is separate.
server {
    listen 443 ssl;
    server_name @CANONICAL_HOST@;
    ssl_certificate @TLS_CERTIFICATE_PATH@;
    ssl_certificate_key @TLS_PRIVATE_KEY_PATH@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;

    # The application may receive contact text and model prompts in URLs or
    # headers. Use an approved redacted edge logging policy instead.
    access_log off;
    client_max_body_size @APPROVED_UPLOAD_LIMIT@;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";

        # POST returns 202 JSON in durable mode; the subsequent GET is SSE.
        # Both must remain unbuffered and must not be cached by the edge.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 900s;
        proxy_send_timeout 60s;
        add_header X-Accel-Buffering no always;
    }
}
