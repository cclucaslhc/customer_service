# Install only with an explicit private receiver token file. No addresses/keys.
route:
  receiver: operator-email
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
receivers:
  - name: operator-email
    webhook_configs:
      - url: http://127.0.0.1:8012/alerts
        send_resolved: true
        max_alerts: 32
        timeout: 70s
        http_config:
          follow_redirects: false
          authorization:
            type: Bearer
            credentials_file: /etc/customer-service/notification-receiver.token
